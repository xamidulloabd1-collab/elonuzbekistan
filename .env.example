# PostgreSQL ulanish manzili
# Format: postgresql://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA_NOMI
DATABASE_URL="postgresql://postgres:parol@localhost:5432/elonuz?schema=public"

# Migratsiyalar uchun to'g'ridan-to'g'ri ulanish. Neon'da: DATABASE_URL bilan bir xil,
# faqat host nomidan "-pooler" so'zi olib tashlanadi. Lokal bazada DATABASE_URL bilan bir xil.
DIRECT_URL="postgresql://postgres:parol@localhost:5432/elonuz?schema=public"

# JWT tokenlarni imzolash uchun maxfiy kalit (production'da uzun tasodifiy matn qo'ying)
JWT_SECRET="juda_maxfiy_uzun_matn_2026"

# Telegram bot (tarif arizalari admin'ga shu bot orqali yuboriladi)
# Bot yaratish: @BotFather ga /newbot yozing. Chat ID olish: @userinfobot ga yozing.
# Botga arizalar kelishi uchun avval botning o'ziga bir marta /start bosing.
TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenHere"
TELEGRAM_CHAT_ID="123456789"

# E'lon tafsilotlari sahifasidagi "Telegram orqali yozish" tugmasi uchun (ixtiyoriy, umumiy)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="elonuz_bot"

# Telegram xabarlariga to'g'ridan-to'g'ri havola qo'shish uchun (ixtiyoriy)
# Masalan production'da: https://elonuz.uz , lokalda bo'sh qoldirsangiz bo'ladi
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Eslatma: e'lon rasmlari Netlify Blobs orqali saqlanadi - bu Netlify'ga
# joylashtirilganda AVTOMATIK ishlaydi, alohida sozlash yoki maxfiy kalit
# kerak emas.

# Tasdiqlash kodi - Telegram Gateway (asosiy kanal). gateway.telegram.org -> API token
TELEGRAM_GATEWAY_TOKEN=""

# Bepul zaxira: Gateway kod yubora olmasa (masalan budjet tugasa), foydalanuvchi kodni
# @elonuzz_bot'dan oladi. Istalgan uzun tasodifiy matn. Keyin bir marta:
#   node scripts/set-telegram-webhook.js https://elonuz.com
TELEGRAM_WEBHOOK_SECRET=""

# SMS (Eskiz.uz) - ixtiyoriy zaxira: raqamda Telegram bo'lmasa, SMS yuboriladi - my.eskiz.uz kabinetidagi login va parol.
# Lokalda bo'sh qoldirsangiz, SMS yuborilmaydi - kod ekranda va terminalda ko'rinadi.
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
# Ixtiyoriy: Eskiz'da tasdiqlangan shablon matni ({code} o'rniga kod qo'yiladi)
# ESKIZ_SMS_TEMPLATE="ElonUz: tasdiqlash kodingiz {code}. Kodni hech kimga bermang."
