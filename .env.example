# PostgreSQL ulanish manzili
# Format: postgresql://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA_NOMI
DATABASE_URL="postgresql://postgres:parol@localhost:5432/elonuz?schema=public"

# JWT tokenlarni imzolash uchun maxfiy kalit (production'da uzun tasodifiy matn qo'ying)
JWT_SECRET="juda_maxfiy_uzun_matn_2026"

# Telegram bot (tarif arizalari admin'ga shu bot orqali yuboriladi)
# Bot yaratish: @BotFather ga /newbot yozing. Chat ID olish: @userinfobot ga yozing.
# Botga arizalar kelishi uchun avval botning o'ziga bir marta /start bosing.
TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenHere"
TELEGRAM_CHAT_ID="123456789"

# E'lon tafsilotlari sahifasidagi "Telegram orqali yozish" tugmasi uchun (ixtiyoriy, umumiy)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="elonuz_bot"

# Telegram xabarlariga to'g'ridan-to'g'ri havola qo'shish uchun (ixtiyoriy)
# Masalan production'da: https://elonuz.uz , lokalda bo'sh qoldirsangiz bo'ladi
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary - e'lon rasmlarini foydalanuvchi galereyasidan yuklash uchun (bepul)
# 1) cloudinary.com'da bepul ro'yxatdan o'ting
# 2) Dashboard'da "Cloud name"ni ko'chiring -> pastga qo'ying
# 3) Settings > Upload > "Upload presets" > "Add upload preset" ->
#    "Signing Mode"ni "Unsigned" qiling, nomini eslab qoling -> pastga qo'ying
# Ikkalasi ham ochiq (public) qiymatlar - xavfsiz, chunki "unsigned" preset
# faqat rasm yuklashga ruxsat beradi, boshqa hech narsaga emas.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="sizning_cloud_nomingiz"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="sizning_preset_nomingiz"
