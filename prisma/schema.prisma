// prisma/schema.prisma
// ElonUz — ma'lumotlar bazasi sxemasi (PostgreSQL + Prisma ORM)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migratsiyalar uchun to'g'ridan-to'g'ri ulanish (Neon pooler advisory lock'ni
  // qo'llab-quvvatlamaydi). Host nomidan "-pooler" olib tashlangan manzil.
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// ENUM'LAR
// ------------------------------------------------------------------

// E'lon kategoriyalari
enum Category {
  KOCHMAS_MULK   // Ko'chmas mulk
  TRANSPORT      // Transport
  AVTO_EHTIYOT_QISMLAR // Avto ehtiyot qismlar
  ELEKTRONIKA    // Elektronika
  ISH_ORINLARI   // Ish o'rinlari
  XIZMATLAR      // Xizmatlar
  UY_JIHOZLARI   // Uy jihozlari (mebel va h.k.)
  KIYIM_ODA      // Kiyim-kechak
  BOSHQA         // Boshqa
}

// O'zbekiston viloyatlari va Toshkent shahri
enum Region {
  TOSHKENT_SHAHAR
  ANDIJON
  BUXORO
  FARGONA
  JIZZAX
  XORAZM
  NAMANGAN
  NAVOIY
  QASHQADARYO
  QORAQALPOGISTON
  SAMARQAND
  SIRDARYO
  SURXONDARYO
  TOSHKENT_VILOYATI
}

// Narx valyutasi
enum Currency {
  UZS
  USD
}

// Foydalanuvchi roli
enum Role {
  USER
  ADMIN
}

// Pullik tarif turlari (Boshlang'ich - bepul, alohida enum qiymati emas)
enum SubscriptionPlan {
  TADBIRKOR   // 50 000 so'm/oy
  BIZNES      // 120 000 so'm/oy - Makler
}

// Obuna holati
enum SubscriptionStatus {
  NONE      // hech qanday ariza berilmagan (Boshlang'ich/bepul holat)
  PENDING   // ariza berilgan, admin tasdig'ini kutmoqda
  ACTIVE    // admin tasdiqlagan, hozir amal qilmoqda
  EXPIRED   // muddati tugagan
}

// SMS tasdiqlash kodining maqsadi
enum OtpPurpose {
  REGISTER         // ro'yxatdan o'tish
  RESET_PASSWORD   // parolni tiklash
}

// E'lon holati (moderatsiya uchun zaxira - hozircha barcha e'lonlar avtomatik faol)
enum ListingStatus {
  ACTIVE     // saytda ko'rinadi
  ARCHIVED   // admin tomonidan yashirilgan
  SOLD       // egasi "Sotildi" deb belgilagan
  EXPIRED    // 30 kunlik muddati tugagan (egasi uzaytirishi mumkin)
}

// Shikoyat sababi
enum ReportReason {
  FRAUD       // firibgarlik
  WRONG_INFO  // noto'g'ri ma'lumot
  PROHIBITED  // taqiqlangan tovar/xizmat
  OFFENSIVE   // haqoratli kontent
  SPAM        // spam / takroriy e'lon
  OTHER       // boshqa
}

enum ReportStatus {
  OPEN
  RESOLVED
}

// ------------------------------------------------------------------
// MODELLAR
// ------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  passwordHash String
  telegramUsername String?
  // Telefon raqami SMS kod orqali tasdiqlanganmi (yangi foydalanuvchilar - doim true)
  phoneVerified    Boolean  @default(false)
  // Telegram bot orqali bildirishnoma yuborish uchun chat ID (bot'da raqamini
  // ulashgan yoki kabinetdan "Ulash" tugmasini bosgan foydalanuvchilarda bo'ladi)
  telegramChatId   String?  @unique
  role         Role       @default(USER)

  // --- Tarif (obuna) holati ---
  subscriptionPlan      SubscriptionPlan?
  subscriptionStatus    SubscriptionStatus @default(NONE)
  subscriptionExpiresAt DateTime?
  // "Tadbirkor" tarifi uchun joriy davrda (30 kunlik muddat ichida) ishlatilgan
  // VIP e'lonlar soni. "Biznes" tarifida cheklov yo'q, shuning uchun bu maydon
  // faqat Tadbirkor uchun ma'noga ega. Har safar admin obunani tasdiqlaganda 0'ga tushadi.
  vipListingsUsed        Int      @default(0)

  // --- Do'stni taklif qilish (referal) tizimi ---
  // Har bir foydalanuvchining o'ziga xos, o'zgarmas referal kodi (havola uchun)
  referralCode     String   @unique @default(cuid())
  // Kim uni taklif qilgan (agar bo'lsa) - o'z-o'ziga bog'langan (self-relation)
  referredBy       User?    @relation("Referrals", fields: [referredById], references: [id])
  referredById     String?
  referrals        User[]   @relation("Referrals")
  // Referal orqali (o'zi taklif qilgan yoki taklif qilingani uchun) tekkan
  // bepul VIP kredit - tarifdan mustaqil, istalgan e'londa ishlatiladi
  bonusVipCredits  Int      @default(0)

  listings     Listing[]
  favorites    Favorite[]

  // --- Ichki xabar almashish (chat) ---
  conversationsAsA Conversation[] @relation("ConversationsAsA")
  conversationsAsB Conversation[] @relation("ConversationsAsB")
  sentMessages     Message[]

  // --- Shikoyatlar va bloklash ---
  reportsMade      Report[]    @relation("ReportsMade")
  reportsReceived  Report[]    @relation("ReportsReceived")
  blocksMade       UserBlock[] @relation("BlocksMade")
  blocksReceived   UserBlock[] @relation("BlocksReceived")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

model Listing {
  id          String        @id @default(cuid())

  title       String
  description String        @db.Text
  category    Category
  region      Region

  price       Decimal       @db.Decimal(14, 2)
  currency    Currency      @default(UZS)

  contactPhone String

  // Rasm URL'lari - MVP bosqichida oddiy string massiv sifatida saqlanadi
  images      String[]      @default([])

  status      ListingStatus @default(ACTIVE)
  views       Int           @default(0)
  isVip       Boolean       @default(false) // "Biznes" tarifidagi foydalanuvchi joylaganda avtomatik true

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  favoritedBy Favorite[]
  conversations Conversation[]
  reports     Report[]

  // E'lon muddati: joylangandan 30 kun o'tib avtomatik EXPIRED bo'ladi
  expiresAt      DateTime?
  // Muddat tugashidan oldin egasiga eslatma yuborilgan vaqt
  reminderSentAt DateTime?
  // Telegram kanalga joylangan postning ID'si (sotilganda belgilash uchun)
  channelMessageId Int?

  // Xaritadagi joylashuv (ixtiyoriy - egasi e'lon joylashda belgilaydi)
  latitude  Float?
  longitude Float?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Qidiruv/filtr so'rovlarida tez-tez ishlatiladigan maydonlarga indeks qo'yamiz
  @@index([category])
  @@index([region])
  @@index([price])
  @@index([createdAt])
  @@index([isVip])
  @@index([status, expiresAt])
  @@index([latitude, longitude])
  @@map("listings")
}

// Foydalanuvchining "sevimli" deb belgilagan e'lonlari
model Favorite {
  id        String   @id @default(cuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  createdAt DateTime @default(now())

  // Bitta foydalanuvchi bitta e'lonni faqat bir marta sevimlilarga qo'sha oladi
  @@unique([userId, listingId])
  @@map("favorites")
}

// Ichki xabar almashish (chat) - ikki foydalanuvchi orasidagi suhbat,
// ixtiyoriy ravishda bitta e'longa bog'langan bo'lishi mumkin.
// Ikkalanchi tomonlama takror suhbat yaratilmasligi uchun participantA/B
// har doim ID bo'yicha kichigi = A, kattasi = B tartibida saqlanadi (ilova
// darajasida ta'minlanadi).
model Conversation {
  id          String   @id @default(cuid())

  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId   String?

  participantA   User  @relation("ConversationsAsA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantAId String
  participantB   User  @relation("ConversationsAsB", fields: [participantBId], references: [id], onDelete: Cascade)
  participantBId String

  messages    Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([participantAId, participantBId, listingId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String

  content        String
  read           Boolean      @default(false)

  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// SMS tasdiqlash kodlari - kodning o'zi emas, faqat HMAC-xeshi saqlanadi
model PhoneOtp {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  ip         String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([ip, createdAt])
  @@map("phone_otps")
}

// Sayt tashriflari (statistika uchun). Har bir kunda har bir tashrifchi bitta
// qator: IP manzil saqlanmaydi, faqat kunlik almashadigan anonim xesh.
model SiteVisit {
  day         DateTime @db.Date
  visitorHash String
  views       Int      @default(1)

  @@id([day, visitorHash])
  @@index([day])
  @@map("site_visits")
}

// Foydalanuvchi shikoyatlari (e'lon yoki foydalanuvchi ustidan)
model Report {
  id             String       @id @default(cuid())
  reporter       User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId     String
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId      String?
  reportedUser   User?        @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedUserId String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

// Bloklangan foydalanuvchilar: blocker endi blocked bilan yozisha olmaydi (ikki tomonlama)
model UserBlock {
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}
